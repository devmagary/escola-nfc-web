# Dependências
node_modules/
.pnpm-store/

# Arquivos de Build
.next/
dist/
out/
build/

# Configuração gerada em tempo de build (scripts/build-config.mjs)
# Apenas o config.js da RAIZ é gerado; js/lib/config.js é código-fonte.
/config.js
# Pacote do painel enviado ao ESP32 (gerado por scripts/painel-build.mjs)
/painel-dist

# Variáveis de ambiente e chaves locais (mantém apenas o modelo)
.env*
!.env.example

# Vercel CLI (projeto/org locais)
.vercel/

# Logs e arquivos de sistema
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
