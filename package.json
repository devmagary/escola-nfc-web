{
  "name": "escola-nfc-web",
  "version": "1.1.0",
  "private": true,
  "description": "Controle de acesso escolar NFC: painel web (Vercel + Supabase), totem da portaria e ferramentas locais.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-config.mjs",
    "dev": "node scripts/build-config.mjs && node scripts/serve-local.mjs",
    "totem": "node scripts/serve-local.mjs",
    "serve": "node scripts/serve-local.mjs",
    "mock": "node scripts/mock-esp.mjs",
    "admin": "node scripts/bootstrap-admin.mjs",
    "lab:start": "npx --yes supabase@2.121.0 start",
    "lab:setup": "node scripts/lab-setup.mjs",
    "lab:stop": "npx --yes supabase@2.121.0 stop",
    "lab:status": "npx --yes supabase@2.121.0 status -o env",
    "lab:reset": "npx --yes supabase@2.121.0 db reset",
    "lab:backup": "npx --yes supabase@2.121.0 db dump --data-only -f supabase/backup.sql",
    "lab:admin": "node scripts/bootstrap-admin.mjs",
    "lab:check": "node scripts/check-lab.mjs",
    "lab:ip": "node scripts/check-lab.mjs --ip",
    "lab:dev": "node scripts/build-config.mjs && node scripts/serve-local.mjs",
    "painel:build": "node scripts/painel-build.mjs",
    "painel:upload": "node scripts/painel-upload.mjs",
    "painel:deploy": "node scripts/painel-build.mjs && node scripts/painel-upload.mjs",
    "test": "node --test tests/",
    "check": "node scripts/check-syntax.mjs"
  },
  "keywords": [
    "nfc",
    "esp32",
    "supabase",
    "controle-de-acesso",
    "escola"
  ],
  "license": "UNLICENSED"
}
