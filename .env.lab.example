# =============================================================================
# Laboratório OFFLINE (branch lab/offline) — modelo de configuração
# =============================================================================
# Use ESTE arquivo como modelo dentro do computador do laboratório:
#
#   1) Copie:      Copy-Item .env.lab.example .env.local
#   2) Suba a pilha:  npm run lab:start     (primeira vez demora minutos)
#   3) Pegue as chaves impressas por:  npm run lab:status
#   4) Preencha ANON_KEY / SERVICE_ROLE_KEY abaixo e rode:
#      npm run build   (gera o config.js do painel)
#      npm run lab:admin  (cria o primeiro administrador)
#
# ⚠️ O arquivo .env.local NUNCA vai para o git (já está no .gitignore).
# ⚠️ As chaves deste Supabase LOCAL só valem dentro do laboratório.
# -----------------------------------------------------------------------------

# Obrigatórias ---------------------------------------------------------------
# Endereço do Supabase local. Use o IP da REDE do notebook (nunca 127.0.0.1,
# senão tablet/ESP32 não alcançam, e as fotos públicas quebram).
SUPABASE_URL=http://192.168.0.81:54321

# Pegue em: npm run lab:status (linhas "anon key" / "service_role key")
SUPABASE_ANON_KEY=COLE-A-CHAVE-ANON-DO-LAB-AQUI

# Criar o painel/totem do notebook: npm run lab:dev  → http://192.168.0.81:5500
ESP_URL=http://192.168.0.73
APP_ENV=lab-offline
APP_VERSION=lab

# Só para criar o primeiro admin do laboratório (npm run lab:admin) ----------
# Também aparece em: npm run lab:status
SUPABASE_SERVICE_ROLE_KEY=COLE-A-SERVICE-ROLE-KEY-DO-LAB-AQUI
ADMIN_EMAIL=admin@lab.local
ADMIN_PASSWORD=escola123
ADMIN_NAME=Administrador Laboratório
