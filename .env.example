# =============================================================================
# Configuração do site (lida em tempo de build por scripts/build-config.mjs)
# =============================================================================
# Copie este arquivo para `.env.local` e preencha os valores.
# O arquivo `.env.local` NUNCA deve ser comitado (já está no .gitignore).
#
# Precedência: variáveis já definidas no ambiente (ex.: painel da Vercel)
# vencem os valores de `.env` e `.env.local`.
# -----------------------------------------------------------------------------

# Obrigatórias ---------------------------------------------------------------
# Project URL do Supabase (Project Settings > API), começando com https://
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "anon" do Supabase (pode ficar no navegador; o RLS protege o banco)
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Opcionais (possuem valores padrão) -----------------------------------------
# Endereço do ESP32-S3 na rede local. Padrão: http://nfc.local
# Em produção local costuma ser algo como http://192.168.0.73
ESP_URL=http://nfc.local

# Ambiente exibido no painel. Padrão: production
APP_ENV=production

# Versão exibida no painel. Padrão: 1.1.0
APP_VERSION=1.1.0

# Caminho de saída do config.js gerado. Padrão: config.js na raiz do projeto.
# CONFIG_OUT=config.js

# =============================================================================
# Bootstrap do primeiro administrador (APENAS LOCAL — NUNCA no navegador)
# =============================================================================
# Usado por `npm run admin` (scripts/bootstrap-admin.mjs) para criar o usuário
# admin já confirmado e o perfil em public.perfis_usuarios.
# A service role key ignora o RLS: mantenha-a somente no seu `.env.local`,
# nunca a exponha em repositório, site publicado ou código do frontend.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta
# ADMIN_EMAIL=admin@escola.exemplo.br
# ADMIN_PASSWORD=uma-senha-forte-com-6-ou-mais-caracteres
# ADMIN_NAME=Administrador do Sistema
